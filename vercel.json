{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build && npm run vercel:prerender",
  "outputDirectory": "dist/client",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.siennashea.co.za"
        }
      ],
      "destination": "https://siennashea.co.za/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/media/optimized/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
